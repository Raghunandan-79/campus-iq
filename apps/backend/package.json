{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build ./src/server.ts --outdir ./dist --target bun",
    "start": "bun dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:seed": "bun src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@electric-sql/pglite": "^0.3.14",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "postgres": "^3.4.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.7",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "26.4.1",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.7",
    "eslint": "10.9.1",
    "supertest": "^7.1.4",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
