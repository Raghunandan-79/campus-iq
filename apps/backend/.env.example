NODE_ENV=development
PORT=8080

# PostgreSQL (Neon). Leave empty to use embedded PGlite for local dev.
DATABASE_URL=
PGLITE_DIR=./.pglite

# Comma-separated allowed browser origins for CORS + mutation checks.
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=30
# When "true", signup requires the email domain to match the college's domain.
REQUIRE_COLLEGE_EMAIL_DOMAIN=false

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# Cloudflare R2 (S3-compatible). Only needed when STORAGE_PROVIDER=r2.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

MAX_UPLOAD_SIZE_MB=20
ALLOWED_FILE_EXTENSIONS=.pdf
ALLOWED_MIME_TYPES=application/pdf

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
